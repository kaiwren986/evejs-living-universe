# Copy to .env in this folder. Docker Compose reads it automatically; it is
# never baked into the image (.dockerignore excludes **/.env*).
#
# Copying this file is optional when you use all default ports. The token below
# is only needed when something OUTSIDE this compose project talks to the
# /_evejs-web/v1 gateway — that is, the browser companion in ../evejs-web-poc.
#
# Why it is not optional across a container boundary: the gateway grants
# token-less access only to peers whose socket address is 127.0.0.1 or ::1
# (server/src/_secondary/express/evejsWebGateway.js). Traffic that crosses a
# container boundary arrives from a Docker bridge address, so it is refused
# without a token no matter which side is containerised.
#
# Generate one and paste the SAME value into ../evejs-web-poc/.env:
#
#   powershell -Command "[Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))"
#
EVEJS_WEB_GATEWAY_TOKEN=

# Docker deployment ports. These defaults match config/server.json. If you
# change one here, Compose passes the same value to the listener, publishes the
# same loopback host port, and builds the matching client-facing URL.
EVEJS_SERVER_PORT=26000
EVEJS_IMAGE_SERVER_PORT=26001
EVEJS_MICROSERVICES_PORT=26002
EVEJS_REDSHIFT_MONITOR_PORT=26400

# POS fuel catch-up during downtime is a gameplay setting. Set it in
# config/gameplay.json (structures.posConsumeFuelWhileServerOffline), which
# Compose mounts into the server container.

# Usually leave these unset so Compose derives loopback URLs from the ports
# above. Set them only when the client must be given a different public URL.
# EVEJS_IMAGE_SERVER_URL=http://127.0.0.1:26001/
# EVEJS_MICROSERVICES_PUBLIC_URL=http://127.0.0.1:26002/
