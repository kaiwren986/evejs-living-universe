node_modules
/client/
_backup/
_local/
**/__pycache__/
*.py[cod]
*.bak
*.tmp-*
*.log
.DS_Store
Thumbs.db
tools/ConfigEditor/assets/
.claude
server/src/_secondary/image/generated/Character
/server/logs
server/tidi_probe.log
/server/src/_secondary/data/chat
/tools/ClientSETUP/scripts/EvEJSConfig.bat
/tools/ClientCodeGrabber/Latest

# Discord bug intake: scraped reports, generated briefs, and the bot token.
# Reports are third-party content and the token is a credential; neither belongs in git.
/tools/DiscordBugIntake/data/
/tools/DiscordBugIntake/config.local.json
/server/src/logs
/tools/DataSync/source_json
/target
/content-packs/build/
/content-packs/evejs-incursion-sites-*.json
/server/src/gameStore/content-packs/

# TLS certificates and private keys from before 21 September 2026. They are in
# _local/certs now, ignored with the rest of _local, but installs keep these old
# copies, so they must stay out of git.
/server/certs/*.pem
/server/src/_secondary/express/certs/*.pem
/server/src/_secondary/express/certs/*.pfx
/server/src/_secondary/express/certs/*passphrase*.txt

# Generated local database data. Run tools/DatabaseCreator/CreateDatabase.bat.
/server/src/gameStore/data/*/data.json

# Runtime-generated images (character portraits, alliance logos). They live in
# the gameStore root beside gamestore.sqlite, which is _local/gameStore on a
# normal install and lands in the source tree on a bare checkout with no _local.
/server/src/gameStore/images/

# SQLite runtime database (gameStore backend) and its WAL/SHM sidecars.
# Never commit: it holds per-install runtime state and lands in the source
# tree on a fresh setup with no _local data dir.
*.sqlite
*.sqlite-wal
*.sqlite-shm
/tools/PlayerConnect
/tools/PlayerConnect-v2
/tools/market-seederv2/cache/
/tools/market-seederv2/target/
/tools/ClientCodeGrabberV2

# Compose environment. Holds EVEJS_WEB_GATEWAY_TOKEN, a shared secret.
.env
.env.local
/.codex-tmp
/.tmp/

# Legacy Abyssal telemetry is regenerated ephemerally from the canonical CSV.
/server/src/abyssal/catalog/content/tier[0-6]AbyssalSpaceTelemetry.generated.json
/server/src/abyssal/catalog/content/observedAbyssalNpcSpawns.generated.json

# QSNA scraper HTTP cache is machine-local and regenerated by the scraper.
/tools/AbyssalData/scraper/output/qsna-scrape-cache.json

# Local working roadmap; intentionally kept out of version control.
/doc/PARITY_FEATURE_ROADMAP.md

AGENTS.md
/.clairvoyance
